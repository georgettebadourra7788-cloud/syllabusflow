# Copy this file to .env.local and fill in real values.

# Google Generative AI (Gemini) — used server-side by src/app/api/generate/route.ts
GOOGLE_GENERATIVE_AI_API_KEY=

# Firebase client config (safe to expose in the browser bundle) — from
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account (server-only secret — never expose to the
# browser). From Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key. Paste the entire downloaded JSON file's contents
# here as a single line.
FIREBASE_SERVICE_ACCOUNT_KEY=
