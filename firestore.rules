rules_version = '2';

// Deploy this in Firebase Console -> Firestore Database -> Rules, or via
// `firebase deploy --only firestore:rules` with the Firebase CLI.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read their own plan/usage doc (to show "X of 3 left"),
    // but can never write it directly — all writes happen server-side via
    // the Admin SDK (which bypasses these rules), so a user can't reset
    // their own generation count or flip themselves to "paid" by editing
    // client code.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Export-button click events, logged client-side for basic usage
    // analytics (which export formats get used, by which plan tier).
    // Users can log their own clicks but never read, edit, or delete any
    // of this collection — analytics review happens server-side/via the
    // Admin SDK or Firebase console, not through the app. `createdAt`
    // must equal the request's server time, so a client can't backdate
    // or forge when an event happened.
    match /exportEvents/{eventId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(["uid", "exportType", "tier", "createdAt"])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.exportType in
                       ["pdf", "html", "slide-outline", "quiz-outline", "outcomes-xlsx"]
                    && request.resource.data.tier in ["free", "paid"]
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
